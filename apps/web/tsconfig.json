{
  "extends": "../../packages/config/typescript/base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@pet-showcase/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@pet-showcase/ui": [
        "../../packages/ui/src/index.ts"
      ]
    },
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve"
  },
  "include": [
    "app",
    "components",
    "lib",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
